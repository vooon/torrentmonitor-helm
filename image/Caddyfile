# FrankenPHP (Caddy + PHP). Plain HTTP on :8080 behind an ingress; non-root.
{
	admin off
	auto_https off
	frankenphp
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /app
	encode zstd gzip
	log {
		output stdout
		format json
	}

	handle /healthz {
		respond "ok" 200
	}

	# Allowlist: the entry points the browser and API clients use, and static
	# files. Everything else (class/, include/, trackers/, engine.php,
	# config.xml, version.txt, torrents/, ...) is internal: 404.
	@public path / /index.php /action.php /include/show_watching_themes.php /api /api/* /rss /rss/* /assets/* /img/* /favicon.ico /robots.txt
	handle @public {
		# The API is a front controller (upstream's api/.htaccess).
		route /api* {
			php_server {
				try_files {path} /api/index.php
			}
		}
		php_server
	}
	handle {
		respond 404
	}
}
