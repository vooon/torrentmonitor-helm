# FrankenPHP (Caddy + PHP). Plain HTTP on :8080 behind an ingress; non-root.
{
	admin off
	auto_https off
	frankenphp
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /app
	encode zstd gzip
	log {
		output stdout
		format json
	}

	handle /healthz {
		respond "ok" 200
	}

	# The self-update page (Update::main is patched to a no-op anyway).
	handle /include/update.php {
		respond 404
	}

	# Allowlist: the entry points the browser and API clients use, and static
	# files. include/*.php are the UI's page sections, loaded by the frontend
	# as "include/<page>.php"; each checks the login itself (Sys::checkAuth).
	# Everything else (class/, trackers/, engine.php, config.xml,
	# version.txt, torrents/, ...) is internal: 404.
	@public path / /index.php /action.php /include/* /api /api/* /rss /rss/* /assets/* /img/* /favicon.ico /robots.txt
	handle @public {
		# The API is a front controller (upstream's api/.htaccess).
		route /api* {
			php_server {
				try_files {path} /api/index.php
			}
		}
		php_server
	}
	handle {
		respond 404
	}
}
